{
  "name": "@cerebro/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file=../../db/seed.sql"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "hono": "^4.6.12",
    "tsx": "^4.23.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.39.0"
  }
}
