# Cabeceras de Cloudflare Pages - SUPRIME
#
# NOTA DE CODIFICACION: este archivo va en ASCII puro, sin acentos ni guiones
# largos. Pages lo parsea linea a linea y el fichero anterior estaba corrupto
# (los acentos salian como bytes rotos: "a?o", "versi?n"). Con el fichero
# danado, Pages ignoraba las reglas y aplicaba su valor por defecto a todo.
# Si se edita este archivo, que sea solo ASCII.
#
# VALOR POR DEFECTO DE PAGES: public, max-age=31536000, must-revalidate. Un
# ano. Asi que todo lo que se sirva sin hash en el nombre tiene que declarar su
# propio Cache-Control aqui, o el cambio no llegara hasta el ano siguiente.

# Bundles de Vite: llevan hash de contenido, son inmutables, se cachean un ano.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# config.js se reescribe en cada despliegue con la URL de la API.
/config.js
  Cache-Control: public, max-age=300, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=86400

# Iconos y logo de marca. NO llevan hash en el nombre, asi que no pueden
# cachearse un ano como los bundles: un icono nuevo tardaria un ano en llegar a
# quien ya tiene el viejo. Una hora es de sobra para un favicon.
# Rutas explicitas, no comodines: Pages no admite "*" en medio del nombre.
/favicon-16.png
  Cache-Control: public, max-age=3600
/favicon-32.png
  Cache-Control: public, max-age=3600
/favicon-48.png
  Cache-Control: public, max-age=3600
/apple-touch-icon.png
  Cache-Control: public, max-age=3600
/apple-touch-icon-152.png
  Cache-Control: public, max-age=3600
/apple-touch-icon-167.png
  Cache-Control: public, max-age=3600
/icon-192.png
  Cache-Control: public, max-age=3600
/icon-512.png
  Cache-Control: public, max-age=3600
/rayo-128.png
  Cache-Control: public, max-age=3600
/rayo-256.png
  Cache-Control: public, max-age=3600

/og-cover.svg
  Cache-Control: public, max-age=3600

/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
