# Cabeceras de Cloudflare Pages — SUPRIME
#
# Sin este archivo, Pages aplica sus valores por defecto (max-age=14400 en los
# assets), lo que obliga a revalidar en cada visita. Como el nombre de los
# bundles incluye el hash de contenido de Vite, son inmutables y se pueden
# cachear un año sin riesgo de servir una versión vieja.

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/config.js
  Cache-Control: public, max-age=300, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=86400

/icon.svg
  Cache-Control: public, max-age=604800

/og-cover.svg
  Cache-Control: public, max-age=604800

/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
