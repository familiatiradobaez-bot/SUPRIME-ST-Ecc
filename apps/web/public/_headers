# Cabeceras de Cloudflare Pages - SUPRIME
#
# ASCII PURO, sin acentos ni guiones largos: Pages lo parsea linea a linea y el
# fichero anterior estaba corrupto (los acentos salian como bytes rotos), y con
# el fichero danado Pages ignoraba las reglas. Si se edita, que sea solo ASCII.
#
# ADVERTENCIA IMPORTANTE (medido en produccion, 2026-09-30):
# Cloudflare SOBREESCRIBE el Cache-Control de estas respuestas. Se comprobo
# poniendo una cabecera de control X-H-Probe, que Cloudflare no toca: la sonda
# SI aparecia en la respuesta, asi que esta regla se aplicaba, pero el
# Cache-Control seguia siendo el de Pages (public, max-age=31536000,
# must-revalidate) y no el declarado aqui. Por eso los ficheros sin hash en el
# nombre necesitan ademas la Cache Rule "root-static-short-cache" de la zona,
# que es la que manda de verdad en el TTL del navegador. Aqui se deja el
# Cache-Control igual, para cuando se sirva sin Cloudflare delante.
#
# OTRA ADVERTENCIA: una ruta repetida hace que Pages aplique solo un bloque y
# pierda el otro. Cada ruta aparece UNA vez en todo el fichero. Se repitieron
# /favicon-32.png y /rayo-128.png al anadir los iconos y sus reglas quedaron
# anuladas.

# Bundles de Vite: llevan hash de contenido, son inmutables, se cachean un ano.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# config.js se reescribe en cada despliegue con la URL de la API.
/config.js
  Cache-Control: public, max-age=300, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=86400

# Iconos y logo de marca. NO llevan hash en el nombre, asi que no pueden
# cachearse un ano como los bundles: un icono nuevo tardaria un ano en llegar a
# quien ya tiene el viejo. Una hora es de sobra para un favicon.
/favicon-16.png
  Cache-Control: public, max-age=3600
/favicon-32.png
  Cache-Control: public, max-age=3600
/favicon-48.png
  Cache-Control: public, max-age=3600
/apple-touch-icon.png
  Cache-Control: public, max-age=3600
/apple-touch-icon-152.png
  Cache-Control: public, max-age=3600
/apple-touch-icon-167.png
  Cache-Control: public, max-age=3600
/icon-192.png
  Cache-Control: public, max-age=3600
/icon-512.png
  Cache-Control: public, max-age=3600
/rayo-128.png
  Cache-Control: public, max-age=3600
/rayo-256.png
  Cache-Control: public, max-age=3600

/og-cover.svg
  Cache-Control: public, max-age=3600

/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
