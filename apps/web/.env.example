# Desarrollo local: copiar a .env (no commitear, está en .gitignore)
VITE_API_URL=http://localhost:8789/api/v1

# Imágenes: ImageManager sube vía Worker (POST /upload/imagekit -> ImageKit).
# No requiere key en el front. La IMAGEKIT_PRIVATE_KEY vive como secret del Worker.
# Local: añade IMAGEKIT_PRIVATE_KEY=... a .dev.vars (raíz del proyecto).
