{
  "name": "cerebro-ecommerce",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm --workspace apps/api run build",
    "build:web": "npm --workspace apps/web run build",
    "typecheck": "npm run typecheck:api && npm run typecheck:web",
    "typecheck:api": "npm --workspace apps/api run typecheck",
    "typecheck:web": "npm --workspace apps/web run typecheck",
    "db:migrate": "npm --workspace apps/api run db:migrate",
    "db:seed": "npm --workspace apps/api run db:seed",
    "smoke": "node tests/smoke.mjs",
    "smoke:setup": "node tools/smoke-setup.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "e2e:ui": "playwright test --ui",
    "cf:purge-assets": "node tools/purge-assets.mjs",
    "tokens": "node tools/token-check.mjs",
    "img:check": "node tools/img-check.mjs",
    "backup": "wrangler d1 export DB --remote --output ./backups/d1-backup.sql",
    "backup:local": "wrangler d1 export DB --local --output ./backups/d1-backup-local.sql",
    "network-info": "echo Accede desde tu celular en: && echo http://192.168.0.105:5173",
    "csp:check": "node tools/check-csp.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.1.0"
  }
}
